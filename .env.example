# Resend — required for any website form to actually send.
# The sending domain (lotuscare.ie) must be verified in Resend first.
RESEND_API_KEY=

# Optional. Must be an address on the verified domain; visitors' own
# addresses go in Reply-To, never in From.
MAIL_FROM="Lotus Care Website <noreply@lotuscare.ie>"

# Local testing only — before a sending domain is verified with Resend,
# it restricts delivery to the account's own signup email. Set this to
# that address to redirect every form kind there instead of the real
# lotuscare.ie inboxes. Leave blank in production.
MAIL_TO_OVERRIDE=

# Cloudflare Turnstile — spam protection for the public, anonymous "Have
# Your Say" form only. Create a widget for this site in the Cloudflare
# dashboard (same account as the Workers deploy) to get real values.
# Cloudflare publishes fixed test keys for local dev before that's done:
# site key  1x00000000000000000000AA  (always passes)
# secret    1x0000000000000000000000000000000AA  (always passes)
#
# NOTE: unlike RESEND_API_KEY/TURNSTILE_SECRET_KEY (read server-side at
# request time), this site key is inlined into the client bundle at
# `next build` time — it must be set in the Cloudflare Workers Build
# environment, not just as a runtime secret, or the widget won't render.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical site URL for metadata, sitemap and robots; inlined at build time.
NEXT_PUBLIC_SITE_URL=https://lotus-care.brasonsolutions.com

# Optional. Cloudflare Web Analytics token, inlined at build; blank = no beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=
