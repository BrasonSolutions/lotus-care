    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
